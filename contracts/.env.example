# Copy this file to .env (never commit .env, never share it).

# Only needed to deploy on a public network. Use a dedicated deployment wallet, never your main one.
DEPLOYER_PRIVATE_KEY=

# RPC per network: RPC_URL_<chainId> (otherwise a public endpoint is used, fine for occasional use).
# Main network: Polygon (137); its test network: Polygon Amoy (80002). For example:
# RPC_URL_137=https://polygon-mainnet.example/KEY
# RPC_URL_80002=https://polygon-amoy.example/KEY
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Required on public networks: recipient of early-unlock fees.
TREASURY_ADDRESS=
# Final owner of ProtocolConfig (use a multisig behind a timelock). Leave empty to stay the owner.
PROTOCOL_OWNER=

# Optional overrides of the default terms (empty = defaults)
MIN_EARLY_UNLOCK_FEE_BPS=
MAX_EARLY_UNLOCK_FEE_BPS=
MIN_LOCK_DURATION=
MAX_LOCK_DURATION=

# Not needed in general: an interrupted deployment resumes automatically (deployments/pending/), and
# redeploying a network after a contracts upgrade keeps its ProtocolConfig when the deployer owns it.
# Manual resume, for one network only (remove afterwards): RESUME_PROTOCOL_CONFIG alone keeps that
# ProtocolConfig; the other three reuse lock contracts of the current version.
RESUME_PROTOCOL_CONFIG=
RESUME_LOCK_VAULT=
RESUME_ACCOUNT_FACTORY=
RESUME_NFT_LOCK_VAULT=

# A network already running the current contracts is never redeployed by accident. Set to true to
# redeploy anyway (the new contracts start empty; locks on the old ones are no longer shown).
FORCE_REDEPLOY=

REPORT_GAS=false
