{
  "name": "cryptolock-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "CryptoLock smart contracts: Crypto Locks, NFT Locks and Wallet Locks.",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy": "hardhat run scripts/deploy.ts --network",
    "networks": "hardhat run scripts/list-networks.ts",
    "deploy:networks": "hardhat run scripts/deploy-networks.ts",
    "deploy:rehearsal": "hardhat run scripts/deploy.ts",
    "deploy:polygon-amoy": "hardhat run scripts/deploy.ts --network polygonAmoy",
    "deploy:polygon": "hardhat run scripts/deploy.ts --network polygon",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:base-sepolia": "hardhat run scripts/deploy.ts --network baseSepolia",
    "export-abis": "hardhat run scripts/export-abis.ts",
    "dev:advance-time": "hardhat run scripts/dev-advance-time.ts --network localhost",
    "dev:simulate-yield": "hardhat run scripts/dev-simulate-yield.ts --network localhost",
    "size": "hardhat run scripts/contract-sizes.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@openzeppelin/contracts": "5.6.1",
    "dotenv": "^16.4.5",
    "hardhat": "2.29.2",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "viem": "^2.57.20"
  },
  "overrides": {
    "ws@^8.0.0": "8.23.0",
    "lodash": "4.18.1",
    "bn.js@^4.0.0": "4.12.5",
    "serialize-javascript": "7.1.4",
    "tmp": "0.2.7",
    "cookie": "0.7.2"
  }
}
