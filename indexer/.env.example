# HTTP API
PORT=4000
HOST=127.0.0.1
# Origin allowed to call the API (the web app). "*" allows any origin.
CORS_ORIGIN=http://localhost:3000

# SQLite database file (created automatically)
DB_PATH=data/indexer.db

# Indexing. BATCH_BLOCKS is the largest eth_getLogs range; it shrinks automatically when the RPC
# endpoint refuses a range, then grows back. CONFIRMATIONS: blocks to wait before indexing (empty:
# 16 on Polygon and Polygon Amoy, 2 elsewhere, 0 on the local network).
CONFIRMATIONS=
POLL_INTERVAL_MS=4000
BATCH_BLOCKS=2000

# Abuse protection: requests per minute and per client IP (all requests / preference writes),
# and most recent events returned by the activity endpoint.
RATE_LIMIT_PER_MINUTE=240
WRITE_RATE_LIMIT_PER_MINUTE=12
MAX_ACTIVITY_EVENTS=2000
# Behind a reverse proxy, identify clients by the first X-Forwarded-For address. Only enable it
# when the proxy overwrites that header, otherwise clients could choose their own IP.
TRUST_PROXY=false

# One RPC endpoint per indexed chain: RPC_URL_<chainId>. Defaults: the local network (31337) on
# http://127.0.0.1:8545, Polygon (137) and Polygon Amoy (80002) on public publicnode endpoints (a
# dedicated endpoint is recommended in production). Other chains without an RPC URL are not indexed.
RPC_URL_137=
RPC_URL_80002=
RPC_URL_11155111=
RPC_URL_84532=

# Not indexing the local development network (lancer.bat sets it when it launches on Polygon).
# INDEXER_SKIP_LOCAL=true
