# WalletConnect Cloud project id (https://cloud.reown.com). Without it, only browser wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public URL of the app (used in WalletConnect metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional indexer (../indexer). Enables synced preferences and indexed transaction history.
NEXT_PUBLIC_INDEXER_URL=http://127.0.0.1:4000

# RPC of the main network (Polygon) and of its test network (Polygon Amoy). Empty: public
# endpoints, with automatic fallback between them. A dedicated endpoint (Alchemy, Infura, QuickNode…)
# is recommended in production.
NEXT_PUBLIC_POLYGON_RPC_URL=
NEXT_PUBLIC_POLYGON_AMOY_RPC_URL=

# Other networks use their public endpoint unless overridden here.
# JSON map chainId -> URL, for any of the ~90 supported networks:
NEXT_PUBLIC_RPC_URLS={}
# e.g. NEXT_PUBLIC_RPC_URLS={"42161":"https://arb-mainnet.example/KEY","10":"https://opt-mainnet.example/KEY"}

# Individual variables (still supported).
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_MAINNET_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=

# Public token lists used to find the tokens a wallet holds (CoinGecko, Uniswap, Superchain by
# default). JSON map chainId -> list URLs, replacing the defaults of that network:
NEXT_PUBLIC_TOKEN_LISTS={}

# Gateway used to display NFT metadata stored on IPFS.
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
